# Copy this to .env and fill in your SQL Server details
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# SQL Server connection — Windows Authentication (no username/password needed)
DB_SERVER=your-server-name
DB_DATABASE=sto_management

# Match what you have installed — check via ODBC Data Sources on your PC
# Common values: "ODBC Driver 17 for SQL Server" or "ODBC Driver 18 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Approval thresholds (USD)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=10000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=5000
