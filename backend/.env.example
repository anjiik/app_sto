# Copy this to .env and fill in your values
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# ── SQL Server (Windows Authentication) ───────────────────────────────────────
# DB_SERVER: your server name from SSMS, e.g. LAPTOP-ABC123\SQLEXPRESS
DB_SERVER=your-server-name
DB_DATABASE=sto_management

# Approval thresholds (USD)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=10000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=5000

# ── Authentication mode ────────────────────────────────────────────────────────
# true  → dev/test mode: login uses demo_users table (run npm run seed first)
# false → production mode: login validates against Active Directory via LDAP
PING_DEV_BYPASS=true

# ── Active Directory / LDAP (only needed when PING_DEV_BYPASS=false) ──────────

# AD server URL — ldap:// for plain (port 389), ldaps:// for SSL (port 636)
LDAP_URL=ldap://ad.yourcompany.com

# Domain used to build login UPN: username@LDAP_DOMAIN
# e.g. if users log in as john.doe@yourcompany.com → LDAP_DOMAIN=yourcompany.com
LDAP_DOMAIN=yourcompany.com

# Root of your AD tree — IT will have given you this as base_dn
# e.g. DC=yourcompany,DC=com
LDAP_BASE_DN=DC=yourcompany,DC=com

# ── Service account bind (recommended) ────────────────────────────────────────
# A dedicated AD service account the app uses to search the directory.
# LDAP_BIND_DN can be:
#   UPN format:  svc_sto_app@yourcompany.com
#   DN format:   CN=svc_sto_app,OU=Service,DC=yourcompany,DC=com
#   DOMAIN\user: YOURCOMPANY\svc_sto_app
# Leave both blank to fall back to direct user-bind
LDAP_BIND_DN=svc_sto_app@yourcompany.com
LDAP_BIND_PASSWORD=change-this-to-service-account-password

# ── AD group names (edit backend/src/config/ldapGroups.ts) ────────────────────
# The actual group-to-role mapping is in src/config/ldapGroups.ts, not here.
# Update the adGroup values in that file once IT provides the exact group names.
# TIP: set PING_DEV_BYPASS=false and try logging in — the error message will
# show your exact AD group names so you know what to put in ldapGroups.ts.
