# Copy this to .env and fill in your values
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# Frontend origin for CORS — must match the URL users open in their browser
FRONTEND_ORIGIN=http://localhost:5173

# ── SQL Server (Windows Authentication) ───────────────────────────────────────
# DB_SERVER: your server name from SSMS, e.g. LAPTOP-ABC123\SQLEXPRESS
DB_SERVER=your-server-name
DB_DATABASE=sto_management
# ODBC driver name — must match exactly what's installed on this machine.
# To see installed drivers run: reg query "HKLM\SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers"
# Common values: ODBC Driver 17 for SQL Server | ODBC Driver 13 for SQL Server | SQL Server Native Client 11.0
DB_DRIVER=ODBC Driver 17 for SQL Server

# Approval thresholds (USD)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=10000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=5000

# ── Authentication mode ────────────────────────────────────────────────────────
# true  → dev/test mode: login uses demo_users table (run npm run seed first)
# false → production mode: login validates against Active Directory via LDAP
DEV_BYPASS=true

# ── Active Directory / LDAP (only needed when DEV_BYPASS=false) ───────────────

# AD server URL — ldap:// for plain (port 389), ldaps:// for SSL (port 636)
LDAP_URL=ldap://ad.yourcompany.com

# Domain used to build login UPN: username@LDAP_DOMAIN
# e.g. if users log in as john.doe@yourcompany.com → LDAP_DOMAIN=yourcompany.com
LDAP_DOMAIN=yourcompany.com

# Root of your AD tree — IT will have given you this as base_dn
# e.g. DC=yourcompany,DC=com
LDAP_BASE_DN=DC=yourcompany,DC=com

# ── Service account bind (recommended) ────────────────────────────────────────
# A dedicated AD service account the app uses to search the directory.
# LDAP_BIND_DN can be:
#   UPN format:  svc_sto_app@yourcompany.com
#   DN format:   CN=svc_sto_app,OU=Service,DC=yourcompany,DC=com
#   DOMAIN\user: YOURCOMPANY\svc_sto_app
# Leave both blank to fall back to direct user-bind
LDAP_BIND_DN=svc_sto_app@yourcompany.com
LDAP_BIND_PASSWORD=change-this-to-service-account-password

# ── AD group naming convention ────────────────────────────────────────────────
# Access and roles are derived entirely from AD group membership.
# No in-app user management — IT manages groups in Active Directory.
#
# Group format: {SITE}_{ROLE}
# The site code prefix must match a row in the sites table.
#
# Required suffixes:
#   {SITE}_ADMIN          Full access scoped to that site (edit any STO, revert steps)
#   {SITE}_RECEIVING      Creates new STOs
#   {SITE}_PLANNING       Shipping Planning review
#   {SITE}_LOGISTICS      Shipping Logistics step
#   {SITE}_MANAGEMENT     Management approval
#   {SITE}_FINANCE        Finance approval
#   {SITE}_RECV_LOGISTICS Receiving Logistics / delivery close-out
#
# Example for sites ABC and XYZ:
#   ABC_ADMIN, ABC_RECEIVING, ABC_PLANNING, ABC_LOGISTICS,
#   ABC_MANAGEMENT, ABC_FINANCE, ABC_RECV_LOGISTICS,
#   XYZ_ADMIN, XYZ_RECEIVING, ... etc.
#
# A user not in any matching group is denied login with a clear error message.
