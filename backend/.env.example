# Copy this to .env and fill in your SQL Server details
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# SQL Server connection
DB_SERVER=your-sql-server-hostname
DB_DATABASE=sto_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=1433
# Set to true if your SQL Server uses Windows Authentication via trusted connection
DB_TRUSTED_CONNECTION=false
# Set to false if using self-signed cert in dev
DB_TRUST_SERVER_CERT=true

# Approval thresholds (USD)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=10000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=5000
