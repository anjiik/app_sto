# Copy this to .env and fill in your values
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# Logging. Logs are ALWAYS written to a plain-text file, one per calendar day
# (app-YYYY-MM-DD.log), so they survive when the app runs as a service and
# stdout is discarded. Only failed HTTP requests (4xx/5xx) and real errors are
# logged — successful requests produce no output. LOG_DIR should be an
# absolute, writable path for the service. LOG_RETENTION_DAYS controls how
# many days of log files are kept (older files are deleted at startup).
NODE_ENV=production
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
# LOG_DIR=C:\sto-management\logs   # Windows service example (defaults to backend/logs)

# Frontend origin for CORS — must match the URL users open in their browser
FRONTEND_ORIGIN=http://localhost:5173

# ── SQL Server (Windows Authentication) ───────────────────────────────────────
# DB_SERVER: your server name from SSMS, e.g. LAPTOP-ABC123\SQLEXPRESS
DB_SERVER=your-server-name
DB_DATABASE=sto_management
# ODBC driver name — must match exactly what's installed on this machine.
# To see installed drivers run: reg query "HKLM\SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers"
# Common values: ODBC Driver 17 for SQL Server | ODBC Driver 13 for SQL Server | SQL Server Native Client 11.0
DB_DRIVER=ODBC Driver 17 for SQL Server

# ── Notification Relay (optional) ────────────────────────────────────────────
# If set, the app calls notification_relay to email STO event notifications.
# Leave URL/USER/PASSWORD blank to disable email notifications entirely.
#
# NOTIFICATION_TEST_MODE defaults ON (missing/unset = test mode). While on,
# EVERY notification — requestor-facing (submitted, planning
# approved/revised/rejected) and group-facing (planning queue, management,
# logistics, receipt-closed) alike — is redirected to NOTIFICATION_TEST_EMAIL
# instead of the real recipient. This is the deliberate current setting: no
# real recipient list exists yet for the group-facing emails, so everything
# is kept on the test address as one toggle rather than mixing real and test
# recipients. Set NOTIFICATION_TEST_MODE=false once ready to send for real —
# at that point requestor-facing emails go to the real requestor, and
# group-facing ones are skipped (logged, not sent) until a real per-role/
# per-site distribution list is wired up for them.
#
# NOTIFICATION_TEST_MODE: 'false' turns test mode off. Anything else
#   (including unset) keeps it on.
# NOTIFICATION_TEST_EMAIL: destination used while NOTIFICATION_TEST_MODE is on.
# NOTIFICATION_RELAY_URL: base URL of the notification_relay service
# NOTIFICATION_RELAY_USER / PASSWORD: a publisher or admin account on that service
# NOTIFICATION_RELAY_SUBMITTED_TEMPLATE: template for the requestor's "STO submitted" email (default: sto-submitted)
# NOTIFICATION_RELAY_PLANNING_QUEUE_TEMPLATE: template for the Shipping Planning "new item in your queue" email (default: sto-planning-queue)
# NOTIFICATION_RELAY_PLANNING_APPROVED_TEMPLATE: template for "STO approved by Planning" (default: sto-planning-approved)
# NOTIFICATION_RELAY_PLANNING_REVISION_TEMPLATE: template for "STO requires revision" (default: sto-planning-revision)
# NOTIFICATION_RELAY_PLANNING_REJECTED_TEMPLATE: template for "STO rejected by Planning" (default: sto-planning-rejected)
# NOTIFICATION_RELAY_MANAGEMENT_REQUESTED_TEMPLATE: template for "management approval requested" (default: sto-management-requested)
# NOTIFICATION_RELAY_MANAGEMENT_GRANTED_TEMPLATE: template for "management approval granted" (default: sto-management-granted)
# NOTIFICATION_RELAY_MANAGEMENT_DENIED_TEMPLATE: template for "management approval denied" (default: sto-management-denied)
# NOTIFICATION_RELAY_LOGISTICS_IN_PROGRESS_TEMPLATE: template for "STO in Shipping Logistics processing" (default: sto-logistics-in-progress)
# NOTIFICATION_RELAY_READY_TO_SHIP_TEMPLATE: template for "STO ready to ship" (default: sto-ready-to-ship)
# NOTIFICATION_RELAY_SHIPMENT_EXECUTED_TEMPLATE: template for "STO shipment executed" (default: sto-shipment-executed)
# NOTIFICATION_RELAY_RECEIPT_CLOSED_TEMPLATE: template for "STO receipt confirmed and closed" (default: sto-receipt-closed)
NOTIFICATION_TEST_MODE=true
NOTIFICATION_TEST_EMAIL=ABC123@gmail.com
NOTIFICATION_RELAY_URL=http://localhost:8080
NOTIFICATION_RELAY_USER=svc-sto-app
NOTIFICATION_RELAY_PASSWORD=change-this
NOTIFICATION_RELAY_SUBMITTED_TEMPLATE=sto-submitted
NOTIFICATION_RELAY_PLANNING_QUEUE_TEMPLATE=sto-planning-queue
NOTIFICATION_RELAY_PLANNING_APPROVED_TEMPLATE=sto-planning-approved
NOTIFICATION_RELAY_PLANNING_REVISION_TEMPLATE=sto-planning-revision
NOTIFICATION_RELAY_PLANNING_REJECTED_TEMPLATE=sto-planning-rejected
NOTIFICATION_RELAY_MANAGEMENT_REQUESTED_TEMPLATE=sto-management-requested
NOTIFICATION_RELAY_MANAGEMENT_GRANTED_TEMPLATE=sto-management-granted
NOTIFICATION_RELAY_MANAGEMENT_DENIED_TEMPLATE=sto-management-denied
NOTIFICATION_RELAY_LOGISTICS_IN_PROGRESS_TEMPLATE=sto-logistics-in-progress
NOTIFICATION_RELAY_READY_TO_SHIP_TEMPLATE=sto-ready-to-ship
NOTIFICATION_RELAY_SHIPMENT_EXECUTED_TEMPLATE=sto-shipment-executed
NOTIFICATION_RELAY_RECEIPT_CLOSED_TEMPLATE=sto-receipt-closed

# Approval thresholds (USD) — both trigger dual management approval (shipping + receiving site)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=100000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=20000

# ── Authentication mode ────────────────────────────────────────────────────────
# true  → dev/test mode: login uses demo_users table (run npm run seed first)
# false → production mode: login validates against Active Directory via LDAP
DEV_BYPASS=true

# ── Active Directory / LDAP (only needed when DEV_BYPASS=false) ───────────────

# AD server URL — ldap:// for plain (port 389), ldaps:// for SSL (port 636)
LDAP_URL=ldap://ad.yourcompany.com

# Domain used to build login UPN: username@LDAP_DOMAIN
# e.g. if users log in as john.doe@yourcompany.com → LDAP_DOMAIN=yourcompany.com
LDAP_DOMAIN=yourcompany.com

# Root of your AD tree — IT will have given you this as base_dn
# e.g. DC=yourcompany,DC=com
LDAP_BASE_DN=DC=yourcompany,DC=com

# ── Service account bind (recommended) ────────────────────────────────────────
# A dedicated AD service account the app uses to search the directory.
# LDAP_BIND_DN can be:
#   UPN format:  svc_sto_app@yourcompany.com
#   DN format:   CN=svc_sto_app,OU=Service,DC=yourcompany,DC=com
#   DOMAIN\user: YOURCOMPANY\svc_sto_app
# Leave both blank to fall back to direct user-bind
LDAP_BIND_DN=svc_sto_app@yourcompany.com
LDAP_BIND_PASSWORD=change-this-to-service-account-password

# ── AD group naming convention ────────────────────────────────────────────────
# Access and roles are derived entirely from AD group membership, via the
# GROUP_MAP constant in backend/src/lib/ldap.ts — that file is the source of
# truth; this comment must match it exactly (they have drifted before).
# No in-app user management — IT manages groups in Active Directory.
#
# Group format: APP-{SITE}-STO_Management_{Role}
# The site code prefix must match a row in the sites table.
#
# There is no {SITE}_FINANCE or single {SITE}_MANAGEMENT group — management
# approval is split into two DISTINCT groups per site (shipping-side and
# receiving-side), so a user in only one cannot act on the other's step.
#
# There is also no per-site admin group and no "create an STO" group — any
# authenticated user can create a new STO, and admin access is company-wide
# only (see below), not scoped per site.
#
# Required suffixes:
#   APP-{SITE}-STO_Management_Planning              Shipping Planning review
#   APP-{SITE}-STO_Management_Logistics             Shipping Logistics step
#   APP-{SITE}-STO_Management_Logistics_Receiving   Receiving Logistics / delivery close-out
#   APP-{SITE}-STO_Management_Management            Shipping-site management approval
#   APP-{SITE}-STO_Management_Management_Receiving  Receiving-site management approval
#
# Plus one company-wide admin group (bypasses all per-site checks):
#   APP-STO_MANAGEMENT_ADMIN
#
# Example for sites ABC and ABL:
#   APP-ABC-STO_Management_Planning, APP-ABC-STO_Management_Logistics,
#   APP-ABC-STO_Management_Logistics_Receiving, APP-ABC-STO_Management_Management,
#   APP-ABC-STO_Management_Management_Receiving,
#   APP-ABL-STO_Management_Planning, ... etc.
#
# A user not in any matching group is denied login with a clear error message.
