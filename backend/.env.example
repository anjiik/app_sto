# Copy this to .env and fill in your SQL Server details
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000

# SQL Server connection — Windows Authentication (no username/password needed)
DB_SERVER=your-server-name
DB_DATABASE=ABCDigitalSystemsApps

# Match what you have installed — check via ODBC Data Sources on your PC
# Common values: "ODBC Driver 17 for SQL Server" or "ODBC Driver 18 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Approval thresholds (USD)
MANAGEMENT_APPROVAL_MATERIAL_THRESHOLD=10000
MANAGEMENT_APPROVAL_FREIGHT_THRESHOLD=5000

# ── PingFederate OIDC ──────────────────────────────────────────────────────────
# Set PING_DEV_BYPASS=true during local development to skip PingFederate and use
# the manual group selector instead. Set to false (or remove) in production.
PING_DEV_BYPASS=true

# PingFederate base URL — e.g. https://sso.yourcompany.com
PING_ISSUER_URL=

# OAuth2 client registered in PingFederate for this app
PING_CLIENT_ID=
PING_CLIENT_SECRET=

# Must match the redirect URI registered in PingFederate exactly
# Point this at the frontend /auth/callback route
PING_REDIRECT_URI=http://localhost:5173/auth/callback

# Name of the claim in the ID token that contains the user's AD group
# Common values: memberOf, groups, Group
PING_GROUP_CLAIM=memberOf
